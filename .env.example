PORT=3000

# development (default) shows real 500 error messages; production hides them
NODE_ENV=development

# Tokens for the demo admin endpoint (GET /api/v1/admin/stats).
# Outside production they default to admin-token-123 / viewer-token-123.
# In production NO token is valid until you set these.
# ADMIN_API_TOKEN=change-me-admin
# VIEWER_API_TOKEN=change-me-viewer

# Rate limiting (defaults: 100 requests per 15 minutes per X-API-Key or IP)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW_MS=900000
# Safety ceiling per IP across ALL api keys (stops key-rotation bypass)
# RATE_LIMIT_IP_CEILING=1000

# Behind a reverse proxy, set the number of proxy hops so the real client IP is used.
# TRUST_PROXY=1
